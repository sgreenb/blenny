# Normalize line endings: text files are stored as LF in the repository
# (working-tree copies may use CRLF on Windows via core.autocrlf).
* text=auto

*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.cfg text eol=lf

# Windows batch files keep CRLF so cmd.exe behaves on every machine.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts.
*.lnk binary
*.icns binary
*.ico binary
*.png binary
*.pt binary
